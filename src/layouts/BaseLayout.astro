---
interface Props {
    title: string;
    lang: string;
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>

        <style is:global>
            :root {
                --bg: #070b14;
                --bg-soft: #101728;
                --panel: rgba(16, 23, 40, 0.78);
                --line: rgba(255, 255, 255, 0.08);
                --text: #eaf1ff;
                --muted: #9fb0d1;
                --accent: #6ec1ff;
                --accent-2: #9d7bff;
                --accent-3: #63f0c7;
            }

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background:
                    radial-gradient(
                        circle at 14% 18%,
                        rgba(88, 170, 255, 0.22),
                        transparent 18%
                    ),
                    radial-gradient(
                        circle at 86% 14%,
                        rgba(132, 92, 255, 0.18),
                        transparent 20%
                    ),
                    radial-gradient(
                        circle at 72% 78%,
                        rgba(94, 255, 221, 0.07),
                        transparent 16%
                    ),
                    radial-gradient(
                        circle at 50% 50%,
                        rgba(18, 42, 82, 0.18),
                        transparent 48%
                    ),
                    linear-gradient(
                        180deg,
                        #01030a 0%,
                        #030711 24%,
                        #060c17 55%,
                        #0a1020 100%
                    );
                color: var(--text);
                overflow-x: hidden;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .stars {
                position: fixed;
                inset: 0;
                pointer-events: none;
                overflow: hidden;
                z-index: 0;
                opacity: 0.95;
                background-image:
                    radial-gradient(
                        1px 1px at 25px 30px,
                        rgba(255, 255, 255, 0.75),
                        transparent 55%
                    ),
                    radial-gradient(
                        1px 1px at 90px 80px,
                        rgba(255, 255, 255, 0.68),
                        transparent 55%
                    ),
                    radial-gradient(
                        1px 1px at 160px 140px,
                        rgba(255, 255, 255, 0.72),
                        transparent 55%
                    ),
                    radial-gradient(
                        1px 1px at 220px 50px,
                        rgba(255, 255, 255, 0.62),
                        transparent 55%
                    ),
                    radial-gradient(
                        1px 1px at 300px 120px,
                        rgba(255, 255, 255, 0.7),
                        transparent 55%
                    ),
                    radial-gradient(
                        1px 1px at 40px 190px,
                        rgba(255, 255, 255, 0.62),
                        transparent 55%
                    ),
                    radial-gradient(
                        1px 1px at 180px 210px,
                        rgba(255, 255, 255, 0.68),
                        transparent 55%
                    ),
                    radial-gradient(
                        1px 1px at 340px 220px,
                        rgba(255, 255, 255, 0.66),
                        transparent 55%
                    );
                background-size: 360px 240px;
                animation: starDrift 220s linear infinite;
            }

            .stars::before,
            .stars::after {
                content: "";
                position: absolute;
                inset: -8%;
                pointer-events: none;
            }

            .stars::before {
                opacity: 0.9;
                background-image:
                    radial-gradient(
                        1.5px 1.5px at 60px 40px,
                        rgba(255, 255, 255, 0.95),
                        transparent 58%
                    ),
                    radial-gradient(
                        1.5px 1.5px at 160px 90px,
                        rgba(255, 255, 255, 0.88),
                        transparent 58%
                    ),
                    radial-gradient(
                        1.5px 1.5px at 280px 30px,
                        rgba(255, 255, 255, 0.92),
                        transparent 58%
                    ),
                    radial-gradient(
                        1.5px 1.5px at 340px 120px,
                        rgba(255, 255, 255, 0.82),
                        transparent 58%
                    ),
                    radial-gradient(
                        1.5px 1.5px at 100px 180px,
                        rgba(255, 255, 255, 0.86),
                        transparent 58%
                    ),
                    radial-gradient(
                        1.5px 1.5px at 240px 210px,
                        rgba(255, 255, 255, 0.84),
                        transparent 58%
                    ),
                    radial-gradient(
                        2px 2px at 25px 110px,
                        rgba(110, 193, 255, 0.55),
                        transparent 60%
                    ),
                    radial-gradient(
                        2px 2px at 310px 190px,
                        rgba(157, 123, 255, 0.4),
                        transparent 60%
                    );
                background-size: 420px 280px;
                animation:
                    starDriftReverse 280s linear infinite,
                    starPulse 8s ease-in-out infinite alternate;
            }

            .stars::after {
                opacity: 0.85;
                background:
                    radial-gradient(
                        circle at 14% 18%,
                        rgba(88, 170, 255, 0.16),
                        transparent 18%
                    ),
                    radial-gradient(
                        circle at 86% 14%,
                        rgba(132, 92, 255, 0.16),
                        transparent 20%
                    ),
                    radial-gradient(
                        circle at 74% 76%,
                        rgba(94, 255, 221, 0.06),
                        transparent 14%
                    ),
                    radial-gradient(
                        circle at 52% 52%,
                        rgba(26, 52, 98, 0.14),
                        transparent 36%
                    );
                filter: blur(2px);
                animation: glowShift 18s ease-in-out infinite alternate;
            }

            @keyframes starDrift {
                from {
                    transform: translate3d(0, 0, 0) scale(1);
                }
                to {
                    transform: translate3d(-1.2%, -0.8%, 0) scale(1.02);
                }
            }

            @keyframes starDriftReverse {
                from {
                    transform: translate3d(0, 0, 0) scale(1);
                }
                to {
                    transform: translate3d(1%, 0.7%, 0) scale(1.025);
                }
            }

            @keyframes starPulse {
                0% {
                    opacity: 0.72;
                }
                50% {
                    opacity: 0.96;
                }
                100% {
                    opacity: 0.8;
                }
            }

            @keyframes glowShift {
                0% {
                    opacity: 0.72;
                    transform: scale(1);
                }
                100% {
                    opacity: 0.92;
                    transform: scale(1.03);
                }
            }

            .twinkle {
                position: absolute;
                inset: 0;
                pointer-events: none;
                background-repeat: repeat;
                opacity: 0;
                mix-blend-mode: screen;
            }

            .twinkle-a {
                background-image:
                    radial-gradient(
                        2.5px 2.5px at 80px 60px,
                        rgba(255, 255, 255, 1),
                        transparent 62%
                    ),
                    radial-gradient(
                        2.5px 2.5px at 240px 120px,
                        rgba(255, 255, 255, 0.98),
                        transparent 62%
                    ),
                    radial-gradient(
                        2px 2px at 420px 80px,
                        rgba(110, 193, 255, 0.95),
                        transparent 62%
                    ),
                    radial-gradient(
                        2.5px 2.5px at 620px 180px,
                        rgba(255, 255, 255, 0.98),
                        transparent 62%
                    ),
                    radial-gradient(
                        2px 2px at 150px 220px,
                        rgba(157, 123, 255, 0.9),
                        transparent 62%
                    ),
                    radial-gradient(
                        2.5px 2.5px at 760px 100px,
                        rgba(255, 255, 255, 1),
                        transparent 62%
                    );
                background-size: 900px 320px;
                animation: twinkleA 7s ease-in-out infinite;
            }

            .twinkle-b {
                background-image:
                    radial-gradient(
                        2.5px 2.5px at 120px 40px,
                        rgba(255, 255, 255, 1),
                        transparent 62%
                    ),
                    radial-gradient(
                        2px 2px at 340px 160px,
                        rgba(110, 193, 255, 0.92),
                        transparent 62%
                    ),
                    radial-gradient(
                        2.5px 2.5px at 540px 70px,
                        rgba(255, 255, 255, 0.98),
                        transparent 62%
                    ),
                    radial-gradient(
                        2px 2px at 700px 210px,
                        rgba(157, 123, 255, 0.88),
                        transparent 62%
                    ),
                    radial-gradient(
                        2.5px 2.5px at 860px 130px,
                        rgba(255, 255, 255, 1),
                        transparent 62%
                    ),
                    radial-gradient(
                        2px 2px at 260px 260px,
                        rgba(255, 255, 255, 0.94),
                        transparent 62%
                    );
                background-size: 980px 360px;
                animation: twinkleB 11s ease-in-out infinite;
                animation-delay: 1.8s;
            }

            @keyframes twinkleA {
                0% {
                    opacity: 0.14;
                    filter: blur(0px);
                }
                12% {
                    opacity: 0.34;
                }
                24% {
                    opacity: 0.1;
                }
                38% {
                    opacity: 0.58;
                    filter: blur(0.3px);
                }
                52% {
                    opacity: 0.16;
                }
                68% {
                    opacity: 0.42;
                }
                84% {
                    opacity: 0.12;
                }
                100% {
                    opacity: 0.24;
                    filter: blur(0px);
                }
            }

            @keyframes twinkleB {
                0% {
                    opacity: 0.1;
                    filter: blur(0px);
                }
                18% {
                    opacity: 0.3;
                }
                30% {
                    opacity: 0.12;
                }
                46% {
                    opacity: 0.52;
                    filter: blur(0.35px);
                }
                62% {
                    opacity: 0.14;
                }
                78% {
                    opacity: 0.36;
                }
                92% {
                    opacity: 0.1;
                }
                100% {
                    opacity: 0.22;
                    filter: blur(0px);
                }
            }

            .container {
                width: min(1180px, calc(100% - 2rem));
                margin: 0 auto;
            }

            .topbar {
                position: sticky;
                top: 0;
                z-index: 10;
                backdrop-filter: blur(14px);
                background: rgba(7, 11, 20, 0.72);
                border-bottom: 1px solid var(--line);
            }

            .topbar-inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1rem 0;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 0.8rem;
                font-weight: bold;
                letter-spacing: 0.08em;
            }

            .brand-badge-link {
                display: inline-flex;
                text-decoration: none;
            }

            .brand-badge {
                width: 2.6rem;
                height: 2.6rem;
                border-radius: 50%;
                display: grid;
                place-items: center;
                background: linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-2)
                );
                overflow: hidden;
                flex-shrink: 0;
                transition:
                    transform 0.18s ease,
                    box-shadow 0.18s ease;
            }

            .brand-badge-link:hover .brand-badge,
            .brand-badge-link:focus-visible .brand-badge {
                transform: scale(1.08);
                box-shadow: 0 0 14px rgba(110, 193, 255, 0.22);
            }

            .brand-badge-link:active .brand-badge {
                transform: scale(1.14);
            }

            .brand-logo {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .brand-home-link {
                color: var(--text);
                text-decoration: none;
                font-weight: bold;
                letter-spacing: 0.08em;
                transition: opacity 0.18s ease;
            }

            .brand-home-link:hover,
            .brand-home-link:focus-visible {
                opacity: 0.88;
            }

            .nav-area {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .nav {
                display: flex;
                gap: 1rem;
                color: var(--muted);
                font-size: 0.95rem;
            }

            .lang-dropdown {
                position: relative;
            }

            .lang-dropdown summary {
                list-style: none;
            }

            .lang-dropdown summary::-webkit-details-marker {
                display: none;
            }

            .lang-dropdown-trigger {
                display: inline-flex;
                align-items: center;
                gap: 0.55rem;
                min-height: 2.5rem;
                padding: 0 0.95rem;
                border-radius: 999px;
                border: 1px solid var(--line);
                background: rgba(255, 255, 255, 0.04);
                color: var(--text);
                transition: 0.2s ease;
                font-size: 0.95rem;
                line-height: 1;
                cursor: pointer;
                user-select: none;
            }

            .lang-dropdown-trigger:hover,
            .lang-dropdown[open] .lang-dropdown-trigger {
                background: linear-gradient(
                    135deg,
                    rgba(110, 193, 255, 0.2),
                    rgba(157, 123, 255, 0.2)
                );
                border-color: rgba(110, 193, 255, 0.35);
            }

            .lang-dropdown-menu {
                position: absolute;
                top: calc(100% + 0.6rem);
                right: 0;
                min-width: 180px;
                padding: 0.45rem;
                border-radius: 18px;
                border: 1px solid var(--line);
                background: rgba(10, 16, 30, 0.94);
                backdrop-filter: blur(14px);
                box-shadow: 0 16px 40px rgba(0, 0, 0, 0.32);
                z-index: 30;
            }

            .lang-dropdown-item {
                display: flex;
                align-items: center;
                gap: 0.55rem;
                padding: 0.75rem 0.9rem;
                border-radius: 12px;
                color: var(--text);
                text-decoration: none;
                transition:
                    background 0.18s ease,
                    color 0.18s ease;
            }

            .lang-dropdown-item:hover,
            .lang-dropdown-item.active {
                background: rgba(255, 255, 255, 0.06);
            }

            .lang-flag {
                font-size: 1.05rem;
            }

            .lang-label {
                color: var(--text);
                opacity: 0.92;
                font-weight: 600;
            }

            .lang-btn:hover,
            .lang-btn.active {
                background: linear-gradient(
                    135deg,
                    rgba(110, 193, 255, 0.2),
                    rgba(157, 123, 255, 0.2)
                );
                border-color: rgba(110, 193, 255, 0.35);
            }

            .lang-flag {
                font-size: 1.05rem;
            }

            .lang-label {
                color: var(--text);
                opacity: 0.92;
                font-weight: 600;
            }

            .hero {
                padding: 6rem 0 4rem;
            }

            .hero-grid {
                display: grid;
                grid-template-columns: 1.2fr 0.8fr;
                gap: 2rem;
                align-items: center;
            }

            .eyebrow {
                display: inline-block;
                padding: 0.45rem 0.8rem;
                border: 1px solid rgba(110, 193, 255, 0.25);
                border-radius: 999px;
                color: var(--accent);
                background: rgba(110, 193, 255, 0.08);
                font-size: 0.82rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            h1 {
                margin: 1rem 0 1rem;
                font-size: clamp(2.4rem, 6vw, 5rem);
                line-height: 0.95;
            }

            .hero p {
                color: var(--muted);
                font-size: 1.1rem;
                line-height: 1.75;
                max-width: 42rem;
            }

            .actions {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem;
                margin-top: 2rem;
            }

            .btn {
                padding: 0.95rem 1.25rem;
                border-radius: 999px;
                font-weight: bold;
                transition: 0.2s ease;
                border: 1px solid transparent;
            }

            .btn-primary {
                background: linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-2)
                );
                color: #08111f;
            }

            .btn-secondary {
                border-color: var(--line);
                background: rgba(255, 255, 255, 0.04);
                color: var(--text);
            }

            .btn:hover {
                transform: translateY(-2px);
            }

            .hero-card,
            .panel,
            .stat,
            .cta,
            .translation-box {
                border: 1px solid var(--line);
                background: var(--panel);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            }

            .hero-card {
                padding: 1.4rem;
            }

            .ship {
                aspect-ratio: 16 / 10;
                min-height: 320px;
                border-radius: 18px;
                position: relative;
                overflow: hidden;
                background:
                    radial-gradient(
                        circle at 50% 50%,
                        rgba(110, 193, 255, 0.16),
                        transparent 38%
                    ),
                    linear-gradient(
                        180deg,
                        rgba(255, 255, 255, 0.02),
                        rgba(255, 255, 255, 0.01)
                    ),
                    #0d1527;
                border: 1px solid rgba(255, 255, 255, 0.06);
            }

            .ship-viewer {
                padding: 0;
                background: #081120;
            }

            .ship-viewer iframe {
                width: 100%;
                height: 100%;
                border: 0;
                display: block;
            }

            .ship-image {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0.4rem 0.6rem;
                background:
                    radial-gradient(
                        circle at 50% 50%,
                        rgba(110, 193, 255, 0.14),
                        transparent 40%
                    ),
                    linear-gradient(
                        180deg,
                        rgba(255, 255, 255, 0.02),
                        rgba(255, 255, 255, 0.01)
                    ),
                    #081120;
            }

            .ship-image img {
                width: 112%;
                height: 100%;
                object-fit: contain;
                display: block;
                mix-blend-mode: screen;
                filter: brightness(1.15) contrast(1.2)
                    drop-shadow(0 0 16px rgba(110, 193, 255, 0.22));
                opacity: 0.92;
            }

            .orbit,
            .planet,
            .pulse {
                position: absolute;
            }

            .planet {
                width: 10rem;
                height: 10rem;
                border-radius: 50%;
                top: 16%;
                right: 12%;
                background: radial-gradient(
                    circle at 30% 30%,
                    #7ecbff,
                    #2d5a86 70%,
                    #0f1e33 100%
                );
                box-shadow: 0 0 40px rgba(110, 193, 255, 0.25);
            }

            .orbit {
                inset: 12%;
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 50%;
            }

            .pulse {
                left: 14%;
                bottom: 14%;
                width: 55%;
                height: 2px;
                background: linear-gradient(
                    90deg,
                    transparent,
                    var(--accent),
                    transparent
                );
                box-shadow: 0 0 15px rgba(110, 193, 255, 0.7);
            }

            section {
                padding: 1rem 0 4rem;
            }

            .section-title {
                margin-bottom: 1.25rem;
            }

            .section-title h2 {
                margin: 0 0 0.5rem;
                font-size: 2rem;
            }

            .section-title p {
                margin: 0;
                color: var(--muted);
                line-height: 1.7;
            }
            .region-card {
                border: 1px solid var(--line);
                background: var(--panel);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
                padding: 1.4rem;
            }

            .region-copy h3 {
                margin: 0 0 0.65rem;
            }

            .region-copy p {
                margin: 0;
                color: var(--muted);
                line-height: 1.7;
            }

            .region-details {
                margin-top: 1rem;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
                padding-top: 1rem;
            }

            .region-details summary {
                cursor: pointer;
                color: var(--accent);
                font-weight: 600;
                list-style: none;
            }

            .region-details summary::-webkit-details-marker {
                display: none;
            }

            .region-countries {
                display: flex;
                flex-wrap: wrap;
                gap: 0.65rem;
                margin-top: 1rem;
            }

            .country-chip {
                display: inline-flex;
                align-items: center;
                padding: 0.55rem 0.85rem;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.08);
                color: var(--text);
                font-size: 0.92rem;
            }

            .stats {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 1rem;
            }

            .stat {
                padding: 1.2rem;
            }

            .stat small {
                display: block;
                color: var(--muted);
                margin-bottom: 0.45rem;
            }

            .stat strong {
                font-size: 1.15rem;
            }

            .panels {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 1rem;
            }

            .panel {
                padding: 1.4rem;
            }

            .panel h3 {
                margin-top: 0;
                margin-bottom: 0.8rem;
            }

            .panel p {
                margin: 0;
                color: var(--muted);
                line-height: 1.75;
            }

            .translation-box {
                padding: 1.4rem;
                margin-top: 1.25rem;
            }

            .translation-box h3 {
                margin: 0 0 0.6rem;
            }

            .translation-box p {
                margin: 0;
                color: var(--muted);
                line-height: 1.75;
            }

            .cta {
                padding: 2rem;
                display: grid;
                grid-template-columns: 1.2fr 0.8fr;
                gap: 1rem;
                align-items: center;
            }

            .cta p {
                color: var(--muted);
                line-height: 1.75;
            }

            .status-box {
                padding: 1rem;
                border-radius: 18px;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.06);
            }

            .status-box div {
                display: flex;
                justify-content: space-between;
                padding: 0.45rem 0;
                color: var(--muted);
            }

            footer {
                padding: 2rem 0 3rem;
                color: var(--muted);
                font-size: 0.95rem;
            }

            @media (max-width: 900px) {
                .hero-grid,
                .cta,
                .stats,
                .panels {
                    grid-template-columns: 1fr;
                }

                .topbar-inner,
                .nav-area {
                    flex-wrap: wrap;
                }

                .nav {
                    width: 100%;
                }

                .hero {
                    padding-top: 4rem;
                }
            }
            .panel-link {
                display: block;
                transition:
                    transform 0.2s ease,
                    border-color 0.2s ease,
                    background 0.2s ease;
            }

            .panel-link:hover {
                transform: translateY(-4px);
                border-color: rgba(110, 193, 255, 0.28);
                background: rgba(20, 30, 52, 0.9);
            }

            .department-page {
                padding: 3rem 0 4rem;
            }

            .department-breadcrumbs {
                display: flex;
                gap: 0.55rem;
                align-items: center;
                color: var(--muted);
                font-size: 0.95rem;
                margin-bottom: 1.2rem;
            }

            .department-breadcrumbs a:hover {
                color: var(--text);
            }

            .department-hero {
                display: grid;
                grid-template-columns: 1.15fr 0.85fr;
                gap: 1.5rem;
                align-items: stretch;
                margin-bottom: 2rem;
            }

            .department-hero-copy,
            .department-logo-card,
            .department-card {
                border: 1px solid var(--line);
                background: var(--panel);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            }

            .department-hero-copy {
                padding: 1.6rem;
